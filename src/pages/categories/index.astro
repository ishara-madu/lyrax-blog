---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = getUniqueCategories(posts);

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`Trending Categories | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Explore Categories"
    pageDesc="Browse all trending topics, news, insights, and viral coverage by category."
  >
    {
      categories.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map(({ category, categoryName, count }) => (
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category}`)}
              class="group border-border bg-muted/20 hover:border-accent hover:bg-muted/40 flex items-center justify-between gap-3 rounded-xl border p-4 transition-all duration-200"
            >
              <div class="flex items-center gap-2 min-w-0">
                <CategoryBadge category={categoryName} clickable={false} size="md" />
              </div>
              <span class="text-muted-foreground group-hover:text-foreground shrink-0 whitespace-nowrap text-sm font-medium">
                {count} {count === 1 ? "story" : "stories"}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="border-border rounded-xl border border-dashed p-8 text-center">
          <p class="text-muted-foreground text-lg">
            No categories available yet. Stay tuned for upcoming trends!
          </p>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>

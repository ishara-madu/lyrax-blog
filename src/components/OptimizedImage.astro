---
import type { ImageMetadata } from "astro";
import {
  isCloudinaryUrl,
  getOptimizedImageUrl,
  getCloudinarySrcSet,
  resolveImageUrl,
} from "@/utils/imageOptimizer";

export interface Props {
  src: string | ImageMetadata | undefined;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = "",
  widths = [360, 480, 640, 768, 1024, 1280],
  sizes,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  width,
  height,
  ...rest
} = Astro.props;

const rawUrl = resolveImageUrl(src);
const isCloudinary = isCloudinaryUrl(rawUrl);

// For Cloudinary images, generate f_auto,q_auto default src and responsive srcset
const optimizedSrc = isCloudinary
  ? getOptimizedImageUrl(rawUrl, {
      width: width || (widths.length > 0 ? widths[widths.length - 1] : undefined),
      quality: "auto",
      format: "auto",
    })
  : rawUrl;

const srcSet = isCloudinary && widths.length > 1
  ? getCloudinarySrcSet(rawUrl, widths)
  : undefined;
---

{
  rawUrl && (
    <img
      src={optimizedSrc}
      srcset={srcSet}
      sizes={srcSet ? sizes : undefined}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      width={width}
      height={height}
      {...rest}
    />
  )
}

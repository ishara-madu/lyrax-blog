---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border border-t py-8 space-y-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium text-muted-foreground">
        <a href={getRelativeLocaleUrl(locale, "categories")} class="hover:text-accent transition-colors">Categories</a>
        <a href={getRelativeLocaleUrl(locale, "about")} class="hover:text-accent transition-colors">{t.nav.about}</a>
        <a href={getRelativeLocaleUrl(locale, "faq")} class="hover:text-accent transition-colors">FAQ</a>
        <a href={getRelativeLocaleUrl(locale, "privacy")} class="hover:text-accent transition-colors">Privacy Policy</a>
      </div>
      <Socials />
    </div>

    <div class="border-border/40 border-t pt-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-muted-foreground">
      <div class="flex items-center gap-1.5">
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        <span>•</span>
        <span class="font-semibold text-foreground">{config.site.title}</span>
        <span>•</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
      <div class="text-xs text-muted-foreground/80">
        Curated by <a href={config.site.profile || "https://ishara-madu.github.io/"} target="_blank" rel="noopener noreferrer" class="text-accent font-medium hover:underline">{config.site.author}</a>
      </div>
    </div>
  </div>
</footer>

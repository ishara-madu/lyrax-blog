---
import Layout from "./Layout.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  category?: string;
  tags?: string[];
  author?: string;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  category = "General",
  tags = [],
  author = site.author,
} = Astro.props;

const siteUrl = site.url.replace(/\/+$/, "");
const postUrl = canonicalURL ?? siteUrl;
const categorySlug = slugifyStr(category);

const isDefaultAuthor =
  !author ||
  author === site.author ||
  author === "Ishara M." ||
  author === "Ishara Madushanka" ||
  author === "LyraX Editorial";

const botAuthorName = isDefaultAuthor
  ? site.authorFull ?? "Ishara Madushanka"
  : author;
const botAlternateName = isDefaultAuthor ? "Ishara M." : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${postUrl}#article`,
      isPartOf: {
        "@type": "WebSite",
        "@id": `${siteUrl}#website`,
        name: site.title,
        url: siteUrl,
      },
      headline: title ?? site.title,
      description: description ?? site.description,
      mainEntityOfPage: postUrl,
      url: postUrl,
      image: ogImage ? [ogImage] : undefined,
      ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      articleSection: category,
      ...(tags.length > 0 && { keywords: tags.join(", ") }),
      inLanguage: site.lang ?? "en",
      author: {
        "@type": "Person",
        name: botAuthorName,
        ...(botAlternateName && { alternateName: botAlternateName }),
        ...(site.profile && { url: site.profile }),
      },
      publisher: {
        "@type": "Organization",
        "@id": `${siteUrl}#organization`,
        name: site.title,
        url: siteUrl,
        logo: {
          "@type": "ImageObject",
          url: new URL("default-og.jpg", site.url).href,
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${postUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: category,
          item: `${siteUrl}/categories/${categorySlug}`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: title ?? "Post",
          item: postUrl,
        },
      ],
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />
    {category && <meta property="article:section" content={category} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
